DATABASE_URL=postgres://playcode:playcode@localhost:5432/playcode
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Code execution: "local" runs programs on this machine (development only).
# Production: run Judge0 (https://github.com/judge0/judge0) and point to it.
EXECUTION_BACKEND=local
EXECUTION_CONCURRENCY=4
# JUDGE0_URL=http://judge0:2358
# JUDGE0_TOKEN=
# JUDGE0_LANGUAGE_IDS=c:50,java:62,python:71

# Proctoring snapshots are stored here (use object storage in production).
STORAGE_DIR=.storage

# WhatsApp Cloud API for nudges. Without these, nudges are in-app only.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE_LANG=en

# Where browsers reach the web app and this API (links in messages, SSO redirects).
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Encrypts stored secrets (webhook signing keys, SSO client secrets). Set a long random value in production.
# DATA_KEY=

# Allow webhook and SSO URLs on private networks. Development only; refused in production.
# ALLOW_PRIVATE_URLS=true

# AI coach, question drafting and webcam snapshot review (Claude). Leave unset to switch AI features off.
# ANTHROPIC_API_KEY=
# AI_ENABLED=false
